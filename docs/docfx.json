{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/RedcapApi/RedcapApi.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "src": "api",
        "files": [
          "**/*.yml"
        ],
        "dest": "api"
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "RedcapApi",
      "_appName": "RedcapApi",
      "_enableSearch": true
    }
  }
}
