{
  "stryker-config": {
    "test-projects": [
      "../../tests/RedcapApi.Tests/RedcapApi.Tests.csproj"
    ],
    "mutate": [
      "Utilities/Utils.cs",
      "Api/DefaultRedcapTransport.cs",
      "Api/RedcapApi.cs"
    ],
    "test-case-filter": "Category!=E2E",
    "coverage-analysis": "perTest",
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "report-file-name": "mutation-report",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
